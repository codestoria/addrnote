{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vitepress"]
  },
  "include": [
    "content/**/*.ts",
    ".vitepress/config.ts",
    ".vitepress/theme/**/*.ts",
    ".vitepress/theme/**/*.vue",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", ".vitepress/dist", ".vitepress/cache"]
}
